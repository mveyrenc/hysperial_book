.buttons.is-right
  - if actions.include?(:new) and policy(Bookcase::ContentTagging).create?
    = link_to t('application.new'),
      new_bookcase_content_tagging_path(content_id: record.id),
      class: 'button is-new-action',
      'data-turbo-frame': helpers.dom_id(Bookcase::ContentTagging.new)
  - if actions.include?(:edit) and record.present? and record.persisted? and policy(record).update?
    = link_to t('application.edit'),
      edit_bookcase_content_tagging_path(record),
      class: 'button is-edit-action',
      'data-turbo-frame': helpers.dom_id(record)
  - if actions.include?(:delete) and record.present? and record.persisted? and policy(record).destroy?
    = button_to t('application.delete'),
      bookcase_content_tagging_path(record),
      method: :delete,
      data: { 'turbo-method': :delete, "turbo-confirm": t("application.are_you_sure") },
      class: "button is-delete-action"
