= render Layout::MainArea::Component.new(turbo_frame_tag_id: @record) do |component|
  - component.with_title do
    = @record.name
  - component.with_actions do
    = render Bookcase::ContentTags::Components::ActionButtons::Component.new(actions: %i[edit delete], record: @record.object)
  - component.with_main_section do
    = turbo_frame_tag @record do
      = render Bookcase::ContentTags::Components::Detail::Component.new(@record)
