- if record.all_content_taggings.any?
  .card-box
    - record.all_content_taggings.group_by { |ct| ct.content_tag_family_name }.each do |f, cts|
      .field.is-horizontal
        .field-label
          .label
            = f
        .field-body
          .tags
            - cts.each do |ct|
              - if ct.computed?
                span.tag.is-primary.is-light
                  = ct.content_tag_name
              - else
                span.tag.is-primary
                  = ct.content_tag_name
