.card-box
  = form_with(url: search_books_path, builder: AppFormBuilder::FormBuilder, method: :get, data: { turbo: "false" }) do |f|
    = f.text_field :q, hide_label: true, placeholder: t('application.search_q_placeholder')
    = f.select :kind, options_for_select(kind_select_values, params[:kind]), include_blank: true
    .field
      .buttons
        = f.submit t('application.search'), class: 'button is-primary'
        = link_to t('application.reset search'), books_path, class: 'button'
