= render Layout::MainArea::Component.new(turbo_frame_tag_id: :content_tag_families) do |component|
  - component.with_title do
    = t('.title')
  - component.with_actions do
    - if policy(ContentTagFamily).create?
      = turbo_frame_tag ContentTagFamily.new do
        = render ContentTagFamilies::Components::NewButton::Component.new
  - component.with_left_aside do
    = render ContentTagFamilies::Components::SearchForm::Component.new(params: params, aggs: @records.aggs)
  - component.with_main_section do
    .container
      - if @records.records.any?
        - @records.records.with_highlights.each do |record, highlights|
          = turbo_frame_tag record do
            = render ContentTagFamilies::Components::Card::Component.new(record: record, highlights: highlights)
        = paginate @records.records
      - else
        = render NoRecord::Component.new
