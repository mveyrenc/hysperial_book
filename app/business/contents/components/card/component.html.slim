.card
  .card-header
    .level.card-header-title
      .level-left
        .level-item
          h1.title.is-5
            = record_name
      .level-right
        .level-item
          span.tag
            = record_kind_name

  .card-content
    .media
      .media-left
        - if record_thumbnail and record_thumbnail.file.attached?
          figure.image.is-128x128
            = image_tag record_thumbnail.file.variant(resize_to_fill: [253, 253])
        - else
          = render Contents::Components::NoThumbnail::Component.new(record: record)
    .media-content
      - unless record_alternate_name.blank?
        p.subtitle
          = record_alternate_name
  .card-footer
    - if policy(record).show?
      .card-footer-item
        = link_to t("application.read"),
          content_path(record),
          class: "button is-edit-action",
          target: "_top"
