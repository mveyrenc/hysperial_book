.card-box
  .media
    .media-left
      - if record_thumbnail.present? and record_thumbnail.file.attached?
        figure.image.is-128x128
          = image_tag record_thumbnail.file.variant(resize_to_fill: [258, 258])
      - else
        = render Contents::Components::NoThumbnail::Component.new(record: record)
    .media-content
      h1.title.is-5
        = record_name
      - unless record_alternate_name.blank?
        p.subtitle
          = record_alternate_name
    .media-right
      span.tag
        = record_kind_name
  .level
    .level-left
    .level-right
      - if policy(record).show?
        .level-item
          = link_to t("application.read"),
            content_path(record),
            class: "button is-edit-action",
            target: "_top"
