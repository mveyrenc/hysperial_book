= render Layout::MainArea::Component.new(turbo_frame_tag_id: 'users') do |component|
  - component.with_title do
    = t('.title')
  - component.with_actions do
    - if policy(User).create?
      = turbo_frame_tag User.new do
        = render Users::Components::ActionButtons::Component.new(actions: %i[new])
  - component.with_left_aside do
    = render Users::Components::SearchForm::Component.new(params: params, aggs: @records.aggs)
  - component.with_main_section do
    .container
      - if @records.records.any?
        - @records.records.each do |record|
          = turbo_frame_tag record do
            = render Users::Components::Card::Component.new(record)
        = paginate @records.records
      - else
        = render NoRecord::Component.new
