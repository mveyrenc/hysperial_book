= turbo_model_frame_tag do
  = helpers.turbo_frame_tag "flash", refresh: :replace, 'data-turbo-temporary': true
  = render Layout::Flash::Component.new
  section.section
    - if hero_body? or title? or actions?
      .level
        - if hero_body?
          .level-left
            .level-item
              = hero_body
        - elsif title?
          .level-left
            .level-item
              p.title.is-1
                = title

        - if actions?
          .level-right
            = actions
    - if upper_section?
      = upper_section
    = turbo_object_frame_tag do
      .columns
        - if left_aside?
          .column.is-narrow
            = left_aside
        .column
          = main_section
        - if right_aside?
          .column.is-narrow
            = right_aside
