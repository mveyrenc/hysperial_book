# database & redis setting for docker compose

## PG
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=hysperial_book_development
PGDATA=/var/lib/postgresql/data

## Rails
RAILS_ENV=development
REDIS_URL=redis://redis:6379
DATABASE_URL=postgres://postgres:password@db/hysperial_book_development
DATABASE_TEST_URL=postgres://postgres:password@db/hysperial_book_test

## OpenSearch
# Sets the demo admin user password when using demo configuration, required for OpenSearch 2.12 and higher
OPENSEARCH_INITIAL_ADMIN_PASSWORD=hysp3rial_bOOk
# Prevents execution of bundled demo script which installs demo certificates and security configurations to OpenSearch
DISABLE_INSTALL_DEMO_CONFIG=true
# Disables Security plugin
DISABLE_SECURITY_PLUGIN=true
